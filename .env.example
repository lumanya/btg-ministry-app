# Copy this file to .env and fill it in. Never commit .env.

# Address of the youtube-feed server function, for example:
# https://<your-project-ref>.supabase.co/functions/v1/youtube-feed
# Leave it empty to use the sample videos in src/content/sample.ts.
EXPO_PUBLIC_YOUTUBE_FEED_URL=

# The podcast's RSS feed address, from your podcast host.
# Leave it empty to show the sample episodes (which have no audio).
EXPO_PUBLIC_PODCAST_FEED_URL=
